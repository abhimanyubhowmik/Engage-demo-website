---
import { url } from '../lib/url';
interface Props {
  width?: number;
  /** The complete stacked ENGAGE logo (footer) instead of the brain-and-gear icon next to the wordmark (header). */
  full?: boolean;
  class?: string;
}
const { width = 150, full = false, class: cls } = Astro.props;
const word = url('/images/brand/engage-logo-light');
const height = Math.round((width * 267) / 480);
---
<span class:list={['logo', { 'logo--full': full }, cls]}>
  {
    full ? (
      <img class="logo__full" src={url('/images/brand/engage-logo-blue-full.webp')} width="320" height="332" alt="ENGAGE — Future Engineers" decoding="async" />
    ) : (
      <>
        <img class="logo__icon" src={url('/images/brand/engage-icon.webp')} width={Math.round((height * 188) / 180)} height={height} alt="" decoding="async" />
        <picture class="logo__word">
          <source srcset={`${word}.webp`} type="image/webp" />
          <img src={`${word}.png`} width={width} height={height} alt="ENGAGE — Future Engineers" decoding="async" />
        </picture>
      </>
    )
  }
</span>
