---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/site';
import { url, stripBase } from '../lib/url';

const path = stripBase(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href={url('/')} aria-label="ENGAGE home">
      <Logo width={128} />
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="theme-switch" role="group" aria-label="Colour theme" data-theme-switch>
      <button type="button" data-set-theme="blue" aria-pressed="true" title="Blue theme">
        <span class="theme-switch__dot theme-switch__dot--blue"></span><span class="sr-only">Blue theme</span>
      </button>
      <button type="button" data-set-theme="green" aria-pressed="false" title="Green theme">
        <span class="theme-switch__dot theme-switch__dot--green"></span><span class="sr-only">Green theme</span>
      </button>
    </div>
    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        <li><a href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="mobile-menu__foot">MSCA Doctoral Network · 2025–2029</p>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    transition:
      background-color 0.35s,
      border-color 0.35s,
      backdrop-filter 0.35s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgb(var(--bg-rgb) / 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  /* backdrop-filter would make the header the containing block of the fixed mobile menu */
  .site-header.is-open {
    backdrop-filter: none;
    background: var(--bg);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .site-header__brand {
    display: block;
    flex-shrink: 0;
  }
  .site-header__brand :global(.logo) {
    gap: 9px;
  }
  .site-header__brand :global(.logo__word img) {
    width: 112px;
  }
  .site-header__brand :global(.logo__icon) {
    width: auto;
    height: 58px;
  }
  .theme-switch {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(var(--bg-rgb) / 0.55);
    backdrop-filter: blur(6px);
  }
  .theme-switch button {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .theme-switch button[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.14);
  }
  .theme-switch__dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.25);
    transition: transform 0.2s var(--ease);
  }
  .theme-switch button:hover .theme-switch__dot {
    transform: scale(1.15);
  }
  .theme-switch__dot--green {
    background: linear-gradient(135deg, #5fe3a1, #0e241c);
  }
  .theme-switch__dot--blue {
    background: linear-gradient(135deg, #5ab8f0, #142a49);
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-family: var(--font-display);
    font-stretch: 106%;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text-2);
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .site-nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    background: var(--accent);
  }
  .site-header__toggle {
    display: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.04);
    place-items: center;
    cursor: pointer;
  }
  .site-header__toggle :global(.icon-close) {
    display: none;
  }
  .site-header.is-open :global(.icon-close) {
    display: block;
  }
  .site-header.is-open :global(.icon-open) {
    display: none;
  }
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--bg);
    padding: 24px var(--gutter) 40px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu li + li {
    border-top: 1px solid var(--line);
  }
  .mobile-menu a {
    display: block;
    padding: 18px 0;
    font-family: var(--font-display);
    font-stretch: 116%;
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--accent);
  }
  .mobile-menu__foot {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 32px;
  }
  @media (max-width: 1080px) {
    .site-nav {
      display: none;
    }
    .site-header__toggle {
      display: grid;
    }
    .theme-switch {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .site-header__brand :global(.logo__word img) {
      width: 96px;
    }
    .site-header__brand :global(.logo__icon) {
      height: 48px;
    }
  }
</style>

<script>
  // colour theme switch (green / blue), remembered per browser
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-set-theme]');
  const themeColors: Record<string, string> = { green: '#06120e', blue: '#0b1a30' };
  const applyTheme = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', themeColors[theme] ?? themeColors.blue);
    themeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setTheme === theme)));
  };
  applyTheme(document.documentElement.dataset.theme === 'green' ? 'green' : 'blue');
  themeButtons.forEach((b) =>
    b.addEventListener('click', () => {
      const theme = b.dataset.setTheme!;
      applyTheme(theme);
      try {
        localStorage.setItem('engage-theme', theme);
      } catch {
        /* storage unavailable: the choice lasts for this page only */
      }
    }),
  );

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  if (header && toggle && menu) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });
    window.matchMedia('(min-width: 1081px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
