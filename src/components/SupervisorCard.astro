---
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import { partnerById } from '../data/partners';
import type { Supervisor } from '../data/supervisors';
import { dcPath, supervisorOrg, type DC } from '../lib/data';
import { url, dcLabel, personName } from '../lib/url';
interface Props {
  supervisor: Supervisor & { dcs: DC[] };
}
const { supervisor: s } = Astro.props;
const partner = s.partner ? partnerById[s.partner] : undefined;
const isPostNominal = personName(s.name, s.title) !== `${s.title} ${s.name}`;
---
<article class="sup-card card" id={s.id} data-sup-card data-kind={s.kind}>
  <div class="sup-card__head">
    <div class="sup-card__avatar">
      <Avatar name={s.name} photo={s.photo} kind={s.kind} />
    </div>
    <div>
      <p class="sup-card__kind">{s.kind === 'academic' ? 'Academic supervisor' : 'Industrial supervisor'}</p>
      <h3 class="sup-card__name">
        {s.title && !isPostNominal && <span class="sup-card__title">{s.title}</span>}
        {s.name}
        {s.title && isPostNominal && <span class="sup-card__post">, {s.title}</span>}
      </h3>
      <p class="sup-card__org">
        {supervisorOrg(s)}
        {partner && <span class="muted"> · {partner.country}</span>}
      </p>
      {s.unit && <p class="sup-card__unit">{s.unit}</p>}
    </div>
  </div>
  <p class="sup-card__about">{s.about}</p>
  {
    s.dcs.length > 0 && (
      <div class="sup-card__dcs">
        <p class="sup-card__label">Supervises</p>
        <ul>
          {s.dcs.map((dc) => (
            <li>
              <a href={url(dcPath(dc))}>
                <span class="badge-dc">{dcLabel(dc.data.number)}</span>
                <span>{dc.data.name ?? dc.data.shortTitle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  {
    (s.links?.website || s.links?.scholar || partner) && (
      <div class="sup-card__links">
        {s.links?.website && (
          <a href={s.links.website} target="_blank" rel="noopener">
            <Icon name="globe" size={16} /> Website
          </a>
        )}
        {s.links?.scholar && (
          <a href={s.links.scholar} target="_blank" rel="noopener">
            <Icon name="scholar" size={16} /> Google Scholar
          </a>
        )}
        {!s.links?.website && partner && (
          <a href={partner.website} target="_blank" rel="noopener">
            <Icon name="external" size={16} /> {partner.short}
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .sup-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px;
    height: 100%;
  }
  .sup-card:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgb(var(--accent-rgb) / 0.2);
  }
  .sup-card__head {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 16px;
    align-items: center;
  }
  .sup-card__avatar {
    width: 88px;
    height: 88px;
    border-radius: 22px;
    overflow: hidden;
    font-size: 1.5rem;
    border: 1px solid var(--line-strong);
  }
  .sup-card__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sup-card__kind {
    margin: 0 0 4px;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 700;
    color: var(--accent);
  }
  .sup-card[data-kind='industry'] .sup-card__kind {
    color: var(--orange);
  }
  .sup-card__name {
    margin: 0;
    font-size: 1.22rem;
    line-height: 1.2;
  }
  .sup-card__title {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    font-family: var(--font-body);
    letter-spacing: 0.02em;
    margin-bottom: 2px;
  }
  .sup-card__post {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    font-family: var(--font-body);
  }
  .sup-card__org {
    margin: 4px 0 0;
    font-size: 0.92rem;
    color: var(--text-2);
    line-height: 1.35;
  }
  .sup-card__unit {
    margin: 2px 0 0;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .sup-card__about {
    margin: 0;
    font-size: 0.94rem;
    color: var(--text-2);
    line-height: 1.55;
  }
  .sup-card__label {
    margin: 0 0 8px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sup-card__dcs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .sup-card__dcs a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text);
  }
  .sup-card__dcs a:hover span:last-child {
    color: var(--accent);
  }
  .sup-card__links {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .sup-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    color: var(--text-2);
    text-decoration: none;
  }
  .sup-card__links a:hover {
    color: var(--accent);
  }
</style>
