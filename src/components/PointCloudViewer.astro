---
// A small interactive point-cloud of a worksite rendered on a 2D canvas (no WebGL dependency).
// Drag to orbit; switch between height, semantic and LiDAR-scan colouring.
---
<figure class="pcv" data-pcv>
  <canvas class="pcv__canvas" aria-label="Interactive point cloud of a worksite with an excavator, a haul truck, trees, rocks and a person" role="img"></canvas>
  <div class="pcv__hud">
    <div class="pcv__modes" role="group" aria-label="Colouring">
      <button type="button" class="is-active" data-mode="semantic">Semantic</button>
      <button type="button" data-mode="height">Height</button>
      <button type="button" data-mode="scan">LiDAR scan</button>
    </div>
    <button type="button" class="pcv__spin" data-spin aria-pressed="true">Auto-rotate</button>
  </div>
  <ul class="pcv__legend" data-legend>
    <li><i style="background:#3f8f74"></i>Ground</li>
    <li><i style="background:#a9c2b8"></i>Haul road</li>
    <li><i style="background:#f7a823"></i>Machines</li>
    <li><i style="background:#5fe3a1"></i>Vegetation</li>
    <li><i style="background:#9b6bff"></i>Obstacles</li>
    <li><i style="background:#ff4a2a"></i>Person</li>
  </ul>
  <figcaption class="pcv__hint">Drag to orbit · procedurally generated scene</figcaption>
</figure>

<style>
  .pcv {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #050f0c;
    aspect-ratio: 16 / 11;
    min-height: 340px;
  }
  .pcv__canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }
  .pcv__canvas:active {
    cursor: grabbing;
  }
  .pcv__hud {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    pointer-events: none;
  }
  .pcv__modes {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    background: rgb(4 12 9 / 0.75);
    border: 1px solid var(--line-strong);
    backdrop-filter: blur(6px);
    pointer-events: auto;
  }
  .pcv__modes button,
  .pcv__spin {
    border: 0;
    background: none;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-2);
    cursor: pointer;
  }
  .pcv__modes button.is-active {
    background: var(--green);
    color: var(--ink);
  }
  .pcv__spin {
    pointer-events: auto;
    background: rgb(4 12 9 / 0.75);
    border: 1px solid var(--line-strong);
  }
  .pcv__spin[aria-pressed='true'] {
    color: var(--green);
  }
  .pcv__legend {
    position: absolute;
    left: 14px;
    bottom: 44px;
    margin: 0;
    padding: 10px 12px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 6px 14px;
    font-size: 0.75rem;
    color: var(--text-2);
    border-radius: 10px;
    background: rgb(4 12 9 / 0.7);
    transition: opacity 0.3s;
  }
  .pcv__legend.is-hidden {
    opacity: 0;
  }
  .pcv__legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pcv__legend i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .pcv__hint {
    position: absolute;
    left: 14px;
    bottom: 14px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .pcv {
      aspect-ratio: 4 / 5;
    }
    .pcv__legend {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>

<script>
  type Mode = 'semantic' | 'height' | 'scan';

  function rng(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  // classes: 0 ground, 1 road, 2 machine, 3 vegetation, 4 obstacle, 5 person
  function buildScene() {
    const r = rng(42);
    const xs: number[] = [];
    const ys: number[] = [];
    const zs: number[] = [];
    const cs: number[] = [];
    const push = (x: number, y: number, z: number, c: number) => {
      xs.push(x);
      ys.push(y);
      zs.push(z);
      cs.push(c);
    };
    const roadY = (x: number) => -9 + 3 * Math.sin(x / 9);
    const height = (x: number, y: number) => {
      let z = 0.9 * Math.sin(x * 0.18) * Math.cos(y * 0.21) + 0.45 * Math.sin(x * 0.47 + y * 0.31) + 0.2 * Math.sin(y * 0.9 + 1.3);
      const pit = Math.exp(-(((x - 9) / 4.5) ** 2 + ((y - 2) / 3.5) ** 2));
      const pile = Math.exp(-(((x + 1) / 3) ** 2 + ((y - 9) / 3) ** 2));
      z += -2.4 * pit + 2.6 * pile;
      const dr = Math.abs(y - roadY(x));
      if (dr < 2.6) z = z * (dr / 2.6) * 0.4 - 0.2;
      return z;
    };
    for (let i = 0; i < 17000; i++) {
      const x = -30 + 60 * r();
      const y = -22 + 44 * r();
      push(x, y, height(x, y), Math.abs(y - roadY(x)) < 2.2 ? 1 : 0);
    }
    const box = (cx: number, cy: number, cz: number, sx: number, sy: number, sz: number, n: number, c: number, yaw = 0, pitch = 0) => {
      const cyw = Math.cos(yaw), syw = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
      const areas = [sy * sz, sy * sz, sx * sz, sx * sz, sx * sy, sx * sy];
      const total = areas.reduce((a, b) => a + b, 0);
      for (let i = 0; i < n; i++) {
        let u = (r() - 0.5) * sx, v = (r() - 0.5) * sy, w = (r() - 0.5) * sz;
        let pick = r() * total, f = 0;
        while (pick > areas[f]) pick -= areas[f++];
        if (f === 0) u = -sx / 2; else if (f === 1) u = sx / 2;
        else if (f === 2) v = -sy / 2; else if (f === 3) v = sy / 2;
        else if (f === 4) w = -sz / 2; else w = sz / 2;
        // pitch about local y, then yaw about z
        const u2 = u * cp + w * sp, w2 = -u * sp + w * cp;
        push(cx + u2 * cyw - v * syw, cy + u2 * syw + v * cyw, cz + w2, c);
      }
    };
    // excavator
    const ex = 5, ey = 1.5, ez = height(5, 1.5) + 0.1, yaw = 0.35;
    const at = (lx: number, ly: number) => [ex + lx * Math.cos(yaw) - ly * Math.sin(yaw), ey + lx * Math.sin(yaw) + ly * Math.cos(yaw)];
    let [px, py] = at(0, -1.2); box(px, py, ez + 0.5, 4.4, 0.8, 1, 900, 2, yaw);
    [px, py] = at(0, 1.2); box(px, py, ez + 0.5, 4.4, 0.8, 1, 900, 2, yaw);
    [px, py] = at(-0.2, 0); box(px, py, ez + 1.45, 3.8, 2.6, 0.9, 1300, 2, yaw);
    [px, py] = at(0.9, 0.7); box(px, py, ez + 2.5, 1.4, 1, 1.3, 700, 2, yaw);
    [px, py] = at(-1.8, 0); box(px, py, ez + 2.1, 0.9, 2.4, 0.9, 500, 2, yaw);
    const boomP = -0.7, armP = 0.55;
    const bx = 1.2, bl = 4.4, al = 3;
    [px, py] = at(bx + (bl / 2) * Math.cos(boomP), -0.2); box(px, py, ez + 2 - (bl / 2) * Math.sin(boomP), bl, 0.5, 0.6, 900, 2, yaw, boomP);
    const tipX = bx + bl * Math.cos(boomP), tipZ = ez + 2 - bl * Math.sin(boomP);
    [px, py] = at(tipX + (al / 2) * Math.cos(armP), -0.2); box(px, py, tipZ - (al / 2) * Math.sin(armP), al, 0.42, 0.45, 650, 2, yaw, armP);
    const t2x = tipX + al * Math.cos(armP), t2z = tipZ - al * Math.sin(armP);
    [px, py] = at(t2x, -0.2); box(px, py, t2z, 1, 1.2, 0.8, 400, 2, yaw, 1.1);
    // haul truck on the road
    const tx = -12, ty = roadY(-12), tz = height(-12, ty);
    box(tx + 2.4, ty, tz + 1.6, 1.8, 2.4, 1.6, 600, 2);
    box(tx - 0.8, ty, tz + 2, 4.6, 2.6, 1.6, 1300, 2);
    for (const wx of [tx + 2.2, tx - 0.4, tx - 2.2]) for (const s of [-1, 1]) box(wx, ty + s * 1.3, tz + 0.6, 1.1, 0.5, 1.1, 160, 2);
    // conifers
    for (let i = 0; i < 26; i++) {
      const a = r() * Math.PI * 2;
      const rad = 17 + r() * 10;
      const x = Math.max(-29, Math.min(29, Math.cos(a) * rad * 1.15));
      const y = Math.max(-21, Math.min(21, Math.sin(a) * rad * 0.8));
      if (Math.abs(y - roadY(x)) < 4) continue;
      const z0 = height(x, y);
      const h = 6 + r() * 6;
      for (let k = 0; k < 70; k++) push(x + (r() - 0.5) * 0.3, y + (r() - 0.5) * 0.3, z0 + r() * h * 0.4, 3);
      for (let k = 0; k < 230; k++) {
        const hz = Math.pow(r(), 0.75);
        const rr = (1 - hz) * h * 0.24 * Math.sqrt(r());
        const aa = r() * Math.PI * 2;
        push(x + rr * Math.cos(aa), y + rr * Math.sin(aa), z0 + h * 0.25 + hz * h * 0.8, 3);
      }
    }
    // rocks
    for (let i = 0; i < 16; i++) {
      const x = -24 + r() * 48, y = -18 + r() * 36;
      if (Math.abs(y - roadY(x)) < 3) continue;
      const s = 0.4 + r() * 0.9, z0 = height(x, y);
      for (let k = 0; k < 90; k++) {
        const u = r() * Math.PI * 2, v = Math.acos(2 * r() - 1);
        push(x + s * 1.3 * Math.sin(v) * Math.cos(u), y + s * Math.sin(v) * Math.sin(u), z0 + s * 0.7 * Math.abs(Math.cos(v)), 4);
      }
    }
    // person next to the road
    const hx = -4, hy = roadY(-4) + 3.4, hz = height(hx, hy);
    for (let k = 0; k < 260; k++) {
      const a = r() * Math.PI * 2, t = r();
      push(hx + 0.22 * Math.cos(a), hy + 0.16 * Math.sin(a), hz + t * 1.45, 5);
    }
    for (let k = 0; k < 80; k++) {
      const u = r() * Math.PI * 2, v = Math.acos(2 * r() - 1);
      push(hx + 0.14 * Math.sin(v) * Math.cos(u), hy + 0.14 * Math.sin(v) * Math.sin(u), hz + 1.65 + 0.14 * Math.cos(v), 5);
    }
    return {
      x: Float32Array.from(xs),
      y: Float32Array.from(ys),
      z: Float32Array.from(zs),
      c: Uint8Array.from(cs),
      sensor: [ex + 0.9, ey + 0.7, ez + 3.2] as [number, number, number],
    };
  }

  const SEM: [number, number, number][] = [
    [0.25, 0.56, 0.45],
    [0.66, 0.76, 0.72],
    [0.97, 0.66, 0.14],
    [0.37, 0.89, 0.63],
    [0.61, 0.42, 1.0],
    [1.0, 0.29, 0.16],
  ];
  const RAMP: [number, number, number][] = [
    [0.14, 0.07, 0.31],
    [0.36, 0.12, 0.54],
    [0.76, 0.09, 0.48],
    [1.0, 0.42, 0.1],
    [1.0, 0.71, 0.15],
    [1.0, 0.95, 0.66],
  ];
  const ramp = (t: number, out: Float32Array, o: number) => {
    t = Math.max(0, Math.min(0.999, t)) * (RAMP.length - 1);
    const i = Math.floor(t), f = t - i, a = RAMP[i], b = RAMP[i + 1];
    out[o] = a[0] + (b[0] - a[0]) * f;
    out[o + 1] = a[1] + (b[1] - a[1]) * f;
    out[o + 2] = a[2] + (b[2] - a[2]) * f;
  };

  for (const root of document.querySelectorAll<HTMLElement>('[data-pcv]')) {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d', { alpha: false })!;
    const scene = buildScene();
    const n = scene.x.length;
    const colors = { semantic: new Float32Array(n * 3), height: new Float32Array(n * 3), scan: new Float32Array(n * 3) };
    let zmin = Infinity, zmax = -Infinity;
    for (let i = 0; i < n; i++) {
      if (scene.c[i] <= 1) {
        zmin = Math.min(zmin, scene.z[i]);
        zmax = Math.max(zmax, scene.z[i]);
      }
    }
    const dist = new Float32Array(n);
    for (let i = 0; i < n; i++) {
      const s = SEM[scene.c[i]];
      colors.semantic.set(s, i * 3);
      ramp((scene.z[i] - zmin) / (zmax - zmin + 4), colors.height, i * 3);
      const g = 0.45 + 0.4 * ((i * 2654435761) % 1000) / 1000;
      colors.scan[i * 3] = g * 0.75;
      colors.scan[i * 3 + 1] = g;
      colors.scan[i * 3 + 2] = g * 0.92;
      dist[i] = Math.hypot(scene.x[i] - scene.sensor[0], scene.y[i] - scene.sensor[1]);
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mode: Mode = 'semantic';
    let yaw = -0.6, pitch = 0.48, spin = !reduce, visible = false, dirty = true, last = 0, scanT = 0;
    let W = 0, H = 0, acc = new Float32Array(0), img: ImageData | null = null, bgRow = new Float32Array(0);

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const scale = Math.min(window.devicePixelRatio || 1, 1.4);
      W = Math.max(2, Math.round(rect.width * scale));
      H = Math.max(2, Math.round(rect.height * scale));
      canvas.width = W;
      canvas.height = H;
      acc = new Float32Array(W * H * 3);
      img = ctx.createImageData(W, H);
      bgRow = new Float32Array(H * 3);
      for (let y = 0; y < H; y++) {
        const t = y / H;
        bgRow[y * 3] = 0.02 + 0.02 * t;
        bgRow[y * 3 + 1] = 0.06 + 0.06 * t;
        bgRow[y * 3 + 2] = 0.05 + 0.04 * t;
      }
      dirty = true;
    };

    const render = () => {
      if (!img) return;
      acc.fill(0);
      const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
      const D = 46, f = Math.min(W, H * 1.45) * 1.05, cx0 = W / 2, cy0 = H * 0.52;
      const col = colors[mode];
      const ringR = (scanT * 14) % 34;
      const gain = Math.max(0.6, (W * H) / 900000);
      for (let i = 0; i < n; i++) {
        const x = scene.x[i] * cy - scene.y[i] * sy;
        const y = scene.x[i] * sy + scene.y[i] * cy;
        const z = scene.z[i];
        const depth = y * cp - z * sp + D;
        if (depth < 1) continue;
        const up = y * sp + z * cp;
        const sx = cx0 + (f * x) / depth;
        const syy = cy0 - (f * up) / depth;
        if (sx < 0 || syy < 0 || sx >= W - 1 || syy >= H - 1) continue;
        let w = (70 / depth) * gain;
        let r = col[i * 3], g = col[i * 3 + 1], b = col[i * 3 + 2];
        if (mode === 'scan') {
          const d = Math.abs(dist[i] - ringR);
          if (d < 1.2) {
            const k = 1 - d / 1.2;
            r += k * 1.6;
            g += k * 2.2;
            b += k * 1.8;
          } else if (dist[i] > ringR) {
            w *= 0.35;
          }
        }
        const ix = sx | 0, iy = syy | 0, o = (iy * W + ix) * 3;
        acc[o] += r * w;
        acc[o + 1] += g * w;
        acc[o + 2] += b * w;
        if (depth < 40) {
          const w2 = 0.55;
          const o2 = o + 3, o3 = o + W * 3, o4 = o3 + 3;
          acc[o2] += r * w * w2; acc[o2 + 1] += g * w * w2; acc[o2 + 2] += b * w * w2;
          acc[o3] += r * w * w2; acc[o3 + 1] += g * w * w2; acc[o3 + 2] += b * w * w2;
          acc[o4] += r * w * w2 * 0.6; acc[o4 + 1] += g * w * w2 * 0.6; acc[o4 + 2] += b * w * w2 * 0.6;
        }
      }
      const data = img.data;
      for (let y = 0, p = 0, q = 0; y < H; y++) {
        const br = bgRow[y * 3], bg = bgRow[y * 3 + 1], bb = bgRow[y * 3 + 2];
        for (let x = 0; x < W; x++, p += 3, q += 4) {
          const r = 1 - Math.exp(-acc[p]), g = 1 - Math.exp(-acc[p + 1]), b = 1 - Math.exp(-acc[p + 2]);
          data[q] = (br + (1 - br) * r) * 255;
          data[q + 1] = (bg + (1 - bg) * g) * 255;
          data[q + 2] = (bb + (1 - bb) * b) * 255;
          data[q + 3] = 255;
        }
      }
      ctx.putImageData(img, 0, 0);
    };

    const frame = (t: number) => {
      requestAnimationFrame(frame);
      const dt = Math.min(0.05, (t - last) / 1000 || 0);
      last = t;
      if (visible && spin) {
        yaw += dt * 0.18;
        dirty = true;
      }
      if (visible && mode === 'scan' && !reduce) {
        scanT += dt;
        dirty = true;
      }
      if (dirty) {
        render();
        dirty = false;
      }
    };

    // interaction
    let dragging = false, px = 0, py = 0;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      px = e.clientX;
      py = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      yaw -= (e.clientX - px) * 0.006;
      pitch = Math.max(0.12, Math.min(1.25, pitch + (e.clientY - py) * 0.004));
      px = e.clientX;
      py = e.clientY;
      dirty = true;
    });
    const end = () => (dragging = false);
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    const legend = root.querySelector<HTMLElement>('[data-legend]');
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-mode]')) {
      b.addEventListener('click', () => {
        mode = b.dataset.mode as Mode;
        for (const o of root.querySelectorAll('[data-mode]')) o.classList.toggle('is-active', o === b);
        legend?.classList.toggle('is-hidden', mode !== 'semantic');
        dirty = true;
      });
    }
    const spinBtn = root.querySelector<HTMLButtonElement>('[data-spin]');
    if (spinBtn) {
      spinBtn.setAttribute('aria-pressed', String(spin));
      spinBtn.addEventListener('click', () => {
        spin = !spin;
        spinBtn.setAttribute('aria-pressed', String(spin));
      });
    }

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      dirty = true;
    }).observe(root);
    resize();
    requestAnimationFrame(frame);
  }
</script>
