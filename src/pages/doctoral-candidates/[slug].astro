---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import DcCard from '../../components/DcCard.astro';
import Icon from '../../components/Icon.astro';
import PartnerLogo from '../../components/PartnerLogo.astro';
import { industries, themes } from '../../data/site';
import { getDcs, dcPath, partnerById, supervisorById, supervisorOrg, type DC } from '../../lib/data';
import { url, dcLabel, personName } from '../../lib/url';

export async function getStaticPaths() {
  const dcs = await getDcs();
  return dcs.map((dc, i) => ({
    params: { slug: dc.id },
    props: { dc, prev: dcs[i - 1], next: dcs[i + 1], all: dcs },
  }));
}
interface Props {
  dc: DC;
  prev?: DC;
  next?: DC;
  all: DC[];
}
const { dc, prev, next, all } = Astro.props;
const d = dc.data;
const { Content } = await render(dc);
const theme = themes[d.theme];
const hosts = d.host.map((id) => partnerById[id]).filter(Boolean);
const industryPartners = d.partners.map((id) => partnerById[id]).filter(Boolean);
const team = d.supervisors.map((id) => supervisorById[id]).filter(Boolean);
const paragraphs = (text?: string) => (text ?? '').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
const related = all.filter((o) => o.id !== dc.id && o.data.theme === d.theme).slice(0, 3);
const cover = d.cover ?? (d.industries[0] ? industries[d.industries[0]].image : theme.image);
const label = dcLabel(d.number);
const pageTitle = d.name ? `${d.name} — ${label}` : `${label}: ${d.shortTitle}`;
---
<BaseLayout title={pageTitle} description={`${label} · ${d.title}. ${d.summary}`} image={d.photo ?? cover}>
  <section class="dc-hero">
    <div class="dc-hero__bg" aria-hidden="true">
      <img src={url(cover)} alt="" fetchpriority="high" />
    </div>
    <div class="container dc-hero__grid">
      <div class="dc-hero__text">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={url('/')}>Home</a><span aria-hidden="true">/</span>
          <a href={url('/doctoral-candidates/')}>Doctoral Candidates</a><span aria-hidden="true">/</span>
          <span>{label}</span>
        </nav>
        <p class="dc-hero__eyebrow">
          <span class="badge-dc">{label}</span>
          <a href={url(`/research/#objective-${theme.objective}`)}>{theme.label}</a>
        </p>
        <h1 class="dc-hero__title">{d.title}</h1>
        <p class="dc-hero__name">{d.name ?? 'Doctoral candidate profile coming soon'}</p>
        {
          (hosts.length > 0 || industryPartners.length > 0) && (
            <div class="dc-hero__orgs">
              {hosts.map((p) => (
                <span class="dc-hero__org">
                  <Icon name="building" size={18} /> {p.name}
                </span>
              ))}
              {industryPartners.map((p) => (
                <span class="dc-hero__org is-industry">
                  <Icon name="factory" size={18} /> {p.name}
                </span>
              ))}
            </div>
          )
        }
      </div>
      <div class="dc-hero__portrait">
        <div class="viewfinder">
          <span class="viewfinder__corner tl"></span><span class="viewfinder__corner tr"></span>
          <span class="viewfinder__corner bl"></span><span class="viewfinder__corner br"></span>
          <div class="viewfinder__frame">
            {
              d.photo ? (
                <Avatar name={d.name ?? label} photo={d.photo} loading="eager" />
              ) : (
                <span class="viewfinder__empty">
                  <strong>{label}</strong>
                  <small>{d.name ? 'Photo coming soon' : 'Profile coming soon'}</small>
                </span>
              )
            }
          </div>
          <p class="viewfinder__tag">
            <span>{label}</span>
            <span>{[...hosts.map((h) => h.short), ...industryPartners.map((p) => p.short)].join(' × ') || 'ENGAGE'}</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container dc-body">
      <article class="dc-main">
        {
          d.question && (
            <blockquote class="dc-question">
              <Icon name="quote" size={30} />
              <p>{d.question}</p>
            </blockquote>
          )
        }
        <section class="dc-block" aria-labelledby="project-h">
          <p class="eyebrow">Research project</p>
          <h2 id="project-h">{d.shortTitle}</h2>
          {paragraphs(d.project).length > 0 ? paragraphs(d.project).map((p) => <p>{p}</p>) : <p>{d.summary}</p>}
        </section>
        {
          d.background && (
            <section class="dc-block" aria-labelledby="bg-h">
              <p class="eyebrow">Scientific background</p>
              <h2 id="bg-h" class="sr-only">Scientific background</h2>
              {paragraphs(d.background).map((p) => <p>{p}</p>)}
            </section>
          )
        }
        {
          d.keywords.length > 0 && (
            <section class="dc-block" aria-label="Keywords">
              <p class="eyebrow">Keywords</p>
              <p class="chips">
                {d.keywords.map((k) => (
                  <span class="chip chip--green">{k}</span>
                ))}
              </p>
            </section>
          )
        }
        <div class="prose dc-extra">
          <Content />
        </div>
      </article>

      <aside class="dc-side">
        {
          team.length > 0 && (
            <div class="side-card">
              <p class="side-card__title">Supervision team</p>
              <ul class="team">
                {team.map((s) => (
                  <li>
                    <a href={url(`/supervisors/#${s.id}`)}>
                      <span class="team__avatar">
                        <Avatar name={s.name} photo={s.photo} kind={s.kind} />
                      </span>
                      <span>
                        <strong>{personName(s.name, s.title)}</strong>
                        <small>{supervisorOrg(s)}</small>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          hosts.length > 0 && (
            <div class="side-card">
              <p class="side-card__title">{hosts.length > 1 ? 'Host institutions' : 'Host institution'}</p>
              {hosts.map((p) => (
                <a class="org" href={p.website} target="_blank" rel="noopener">
                  <PartnerLogo partner={p} />
                  <span>
                    {p.name}
                    <small>
                      {p.city}, {p.country}
                    </small>
                  </span>
                </a>
              ))}
            </div>
          )
        }
        {
          industryPartners.length > 0 && (
            <div class="side-card">
              <p class="side-card__title">Industrial partner</p>
              {industryPartners.map((p) => (
                <a class="org" href={p.website} target="_blank" rel="noopener">
                  <PartnerLogo partner={p} />
                  <span>
                    {p.name}
                    <small>
                      {p.city}, {p.country}
                    </small>
                  </span>
                </a>
              ))}
            </div>
          )
        }
        <div class="side-card">
          <p class="side-card__title">Research objective</p>
          <a class="objective" href={url(`/research/#objective-${theme.objective}`)}>
            <strong>0{theme.objective}</strong>
            <span>{theme.label}</span>
          </a>
          <p class="side-card__title" style="margin-top:18px">Industries</p>
          <p class="chips">
            {d.industries.map((i) => (
              <a class="chip" href={url(`/doctoral-candidates/?industry=${i}`)}>
                {industries[i].label}
              </a>
            ))}
          </p>
        </div>
        {
          d.links && (
            <div class="side-card side-links">
              <p class="side-card__title">Connect</p>
              {d.links.email && (
                <a href={`mailto:${d.links.email}`}>
                  <Icon name="mail" size={16} /> Email
                </a>
              )}
              {d.links.linkedin && (
                <a href={d.links.linkedin} target="_blank" rel="noopener">
                  <Icon name="linkedin" size={16} /> LinkedIn
                </a>
              )}
              {d.links.scholar && (
                <a href={d.links.scholar} target="_blank" rel="noopener">
                  <Icon name="scholar" size={16} /> Google Scholar
                </a>
              )}
              {d.links.github && (
                <a href={d.links.github} target="_blank" rel="noopener">
                  <Icon name="github" size={16} /> GitHub
                </a>
              )}
              {d.links.website && (
                <a href={d.links.website} target="_blank" rel="noopener">
                  <Icon name="globe" size={16} /> Website
                </a>
              )}
            </div>
          )
        }
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--elev section--tight">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Also in {theme.label}</p>
              <h2 class="display h3">Related projects</h2>
            </div>
            <a class="link-arrow" href={url(`/doctoral-candidates/?theme=${d.theme}`)}>
              All {theme.short.toLowerCase()} projects <Icon name="arrow-right" />
            </a>
          </div>
          <ul class="related">
            {related.map((o) => (
              <li>
                <DcCard dc={o} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <nav class="container pager" aria-label="Doctoral candidates">
    {
      prev ? (
        <a class="pager__link" href={url(dcPath(prev))}>
          <Icon name="arrow-left" />
          <span>
            <small>{dcLabel(prev.data.number)}</small>
            {prev.data.name ?? prev.data.shortTitle}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    <a class="pager__all" href={url('/doctoral-candidates/')}>All DCs</a>
    {
      next ? (
        <a class="pager__link pager__link--next" href={url(dcPath(next))}>
          <span>
            <small>{dcLabel(next.data.number)}</small>
            {next.data.name ?? next.data.shortTitle}
          </span>
          <Icon name="arrow-right" />
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</BaseLayout>

<style>
  .dc-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(32px, 5vw, 72px));
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .dc-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .dc-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }
  .dc-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(var(--bg-rgb) / 0.96) 0%, rgb(var(--bg-rgb) / 0.82) 50%, rgb(var(--bg-rgb) / 0.5) 100%),
      linear-gradient(180deg, transparent 60%, var(--bg) 100%);
  }
  .dc-hero__grid {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 360px);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .dc-hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
  }
  .dc-hero__eyebrow .badge-dc {
    font-size: 0.95rem;
    padding: 6px 12px;
  }
  .dc-hero__eyebrow a {
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 650;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .dc-hero__title {
    font-size: clamp(1.9rem, 3.6vw, 3.2rem);
    font-stretch: 108%;
    font-weight: 780;
    line-height: 1.08;
    max-width: 24ch;
  }
  .dc-hero__name {
    margin: 22px 0 0;
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--orange);
    letter-spacing: 0.01em;
  }
  .dc-hero__orgs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .dc-hero__org {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgb(var(--accent-rgb) / 0.4);
    background: rgb(var(--bg-rgb) / 0.6);
    font-size: 0.92rem;
    color: var(--text);
  }
  .dc-hero__org :global(svg) {
    color: var(--accent);
  }
  .dc-hero__org.is-industry {
    border-color: rgb(247 168 35 / 0.45);
  }
  .dc-hero__org.is-industry :global(svg) {
    color: var(--orange);
  }
  .viewfinder {
    position: relative;
    padding: 14px;
  }
  .viewfinder__frame {
    aspect-ratio: 3 / 4;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: var(--shadow);
  }
  .viewfinder__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .viewfinder__frame :global(.monogram) {
    font-size: 4rem;
  }
  .viewfinder__empty {
    display: grid;
    place-content: center;
    height: 100%;
    text-align: center;
    gap: 8px;
    background:
      radial-gradient(circle at 25% 20%, rgb(var(--accent-rgb) / 0.25), transparent 55%),
      radial-gradient(circle at 80% 85%, rgb(247 168 35 / 0.22), transparent 55%),
      var(--surface-2);
  }
  .viewfinder__empty strong {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 4rem;
    line-height: 1;
  }
  .viewfinder__empty small {
    color: var(--muted);
  }
  .viewfinder__corner {
    position: absolute;
    width: 34px;
    height: 34px;
    border: 3px solid var(--accent);
  }
  .viewfinder__corner.tl {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
    border-top-left-radius: 10px;
  }
  .viewfinder__corner.tr {
    top: 0;
    right: 0;
    border-left: 0;
    border-bottom: 0;
    border-top-right-radius: 10px;
  }
  .viewfinder__corner.bl {
    bottom: 34px;
    left: 0;
    border-right: 0;
    border-top: 0;
    border-bottom-left-radius: 10px;
  }
  .viewfinder__corner.br {
    bottom: 34px;
    right: 0;
    border-left: 0;
    border-top: 0;
    border-bottom-right-radius: 10px;
  }
  .viewfinder__tag {
    display: flex;
    justify-content: space-between;
    margin: 12px 4px 0;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .viewfinder__tag span:last-child {
    color: var(--muted);
  }

  .dc-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .dc-question {
    margin: 0 0 40px;
    padding: 28px 30px;
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgb(var(--accent-rgb) / 0.12), rgb(247 168 35 / 0.08));
    border: 1px solid var(--line-strong);
  }
  .dc-question :global(svg) {
    color: var(--orange);
    margin-bottom: 10px;
  }
  .dc-question p {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    line-height: 1.25;
  }
  .dc-block {
    padding-bottom: 32px;
    margin-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  .dc-block h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-bottom: 18px;
  }
  .dc-block > p:not(.eyebrow):not(.chips) {
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--text-2);
    max-width: 68ch;
  }
  .dc-block > p:not(.eyebrow):not(.chips):first-of-type + p {
    color: var(--text-2);
  }
  .dc-extra:empty {
    display: none;
  }
  .dc-side {
    display: grid;
    gap: 16px;
    position: sticky;
    top: calc(var(--header-h) + 16px);
  }
  .side-card {
    padding: 20px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-elev);
  }
  .side-card__title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .team a {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: center;
    text-decoration: none;
  }
  .team__avatar {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    overflow: hidden;
    font-size: 0.85rem;
  }
  .team__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team strong {
    display: block;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .team small {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .team a:hover strong {
    color: var(--accent);
  }
  .org {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 14px;
    align-items: center;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .org + .org {
    margin-top: 12px;
  }
  .org :global(.logo-plate) {
    min-height: 52px;
    padding: 8px;
  }
  .org :global(.logo-plate img) {
    max-height: 34px;
  }
  .org :global(.logo-plate--text) {
    font-size: 0.72rem;
  }
  .org small {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .org:hover span {
    color: var(--accent);
  }
  .objective {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-weight: 650;
  }
  .objective strong {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-size: 1.8rem;
    color: var(--accent);
    line-height: 1;
  }
  .objective:hover span {
    color: var(--accent);
  }
  .side-links {
    display: grid;
    gap: 8px;
  }
  .side-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-2);
  }
  .side-links a:hover {
    color: var(--accent);
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-block: 40px 64px;
  }
  .pager__link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    font-weight: 600;
  }
  .pager__link small {
    display: block;
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    color: var(--orange);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .pager__link--next {
    justify-self: end;
    text-align: right;
  }
  .pager__link:hover {
    color: var(--accent);
  }
  .pager__all {
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .pager__all:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 960px) {
    .dc-hero__grid,
    .dc-body {
      grid-template-columns: 1fr;
    }
    .dc-hero__portrait {
      order: -1;
      max-width: 280px;
    }
    .dc-side {
      position: static;
    }
    .related {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
    .pager__all {
      display: none;
    }
  }
</style>
