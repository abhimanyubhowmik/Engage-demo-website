---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import Icon from '../../components/Icon.astro';
import { getNews, formatDate, type NewsPost } from '../../lib/data';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, others: posts.filter((p) => p.id !== post.id).slice(0, 2) } }));
}
interface Props {
  post: NewsPost;
  others: NewsPost[];
}
const { post, others } = Astro.props;
const d = post.data;
const { Content } = await render(post);
---
<BaseLayout title={d.title} description={d.excerpt} image={d.cover}>
  <article>
    <header class="article-hero">
      <img class="article-hero__img" src={url(d.cover)} alt={d.coverAlt} fetchpriority="high" />
      <div class="container article-hero__inner">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={url('/')}>Home</a><span aria-hidden="true">/</span>
          <a href={url('/news/')}>News & Events</a>
        </nav>
        <p class="article-hero__cat">{d.category}</p>
        <h1 class="article-hero__title">{d.title}</h1>
        <p class="article-hero__meta">
          <span><Icon name="calendar" size={16} /> {d.eventDates ?? formatDate(d.date)}</span>
          {d.location && <span><Icon name="pin" size={16} /> {d.location}</span>}
        </p>
      </div>
    </header>

    <div class="section section--paper article-body">
      <div class="container article-body__grid">
        <p class="article-lead">{d.excerpt}</p>
        <div class="prose">
          <Content />
        </div>
      </div>
      {
        d.gallery.length > 0 && (
          <div class="container">
            <h2 class="gallery-title">Photo gallery</h2>
            <ul class="gallery" data-gallery>
              {d.gallery.map((g, i) => (
                <li class:list={{ tall: g.tall }}>
                  <button type="button" data-open={i} aria-label={`Open photo: ${g.alt}`}>
                    <img src={url(g.src)} alt={g.alt} loading="lazy" decoding="async" />
                    <span class="gallery__zoom">
                      <Icon name="expand" size={18} />
                    </span>
                  </button>
                </li>
              ))}
            </ul>
            <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
              <img data-lightbox-img alt="" />
              <p class="lightbox__caption" data-lightbox-caption />
              <button type="button" class="lightbox__btn lightbox__close" data-close aria-label="Close">
                <Icon name="close" size={22} />
              </button>
              <button type="button" class="lightbox__btn lightbox__prev" data-prev aria-label="Previous photo">
                <Icon name="arrow-left" size={22} />
              </button>
              <button type="button" class="lightbox__btn lightbox__next" data-next aria-label="Next photo">
                <Icon name="arrow-right" size={22} />
              </button>
            </dialog>
          </div>
        )
      }
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="section section--tight">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Keep reading</p>
              <h2 class="display h3">More from the network</h2>
            </div>
            <a class="link-arrow" href={url('/news/')}>
              All news <Icon name="arrow-right" />
            </a>
          </div>
          <ul class="more">
            {others.map((p) => (
              <li>
                <NewsCard post={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .article-hero {
    position: relative;
    isolation: isolate;
    min-height: min(78vh, 720px);
    display: flex;
    align-items: flex-end;
    padding-top: var(--header-h);
  }
  .article-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .article-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(6 18 14 / 0.75) 0%, rgb(6 18 14 / 0.2) 60%, transparent 100%),
      linear-gradient(180deg, rgb(6 18 14 / 0.6) 0%, rgb(6 18 14 / 0.1) 30%, rgb(6 18 14 / 0.95) 100%);
  }
  .article-hero__inner {
    padding-block: 40px 56px;
  }
  .article-hero__cat {
    display: inline-block;
    margin: 0 0 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--green);
    color: var(--ink);
    font-family: var(--font-display);
    font-stretch: 110%;
    font-weight: 750;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .article-hero__title {
    font-size: clamp(2rem, 4.6vw, 3.8rem);
    max-width: 22ch;
    font-stretch: 108%;
  }
  .article-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 18px 0 0;
    color: var(--text-2);
  }
  .article-hero__meta span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .article-body__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .article-lead {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 106%;
    font-weight: 650;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    line-height: 1.35;
    color: var(--ink);
    border-left: 4px solid var(--orange);
    padding-left: 22px;
  }
  .article-body .prose {
    color: var(--ink-2);
  }
  .article-body .prose :global(h2) {
    color: var(--ink);
  }
  .article-body .prose :global(p:first-child) {
    margin-top: 0;
  }
  .gallery-title {
    margin-top: clamp(48px, 6vw, 80px);
    font-size: 1.4rem;
    color: var(--ink);
  }
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 240px;
    gap: 12px;
  }
  .gallery li:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }
  .gallery li.tall {
    grid-row: span 2;
  }
  .gallery button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 14px;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--ink);
  }
  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .gallery button:hover img {
    transform: scale(1.04);
  }
  .gallery__zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgb(6 18 14 / 0.7);
    color: #fff;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gallery button:hover .gallery__zoom,
  .gallery button:focus-visible .gallery__zoom {
    opacity: 1;
  }
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px 72px;
    border: 0;
    background: rgb(3 9 7 / 0.96);
    color: var(--text);
  }
  .lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 160px);
    object-fit: contain;
    border-radius: 10px;
  }
  .lightbox__caption {
    margin: 0;
    color: var(--text-2);
    text-align: center;
  }
  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(6 18 14 / 0.7);
    cursor: pointer;
  }
  .lightbox__btn:hover {
    background: var(--green);
    color: var(--ink);
  }
  .lightbox__close {
    top: 16px;
    right: 16px;
  }
  .lightbox__prev {
    left: 16px;
    top: 50%;
  }
  .lightbox__next {
    right: 16px;
    top: 50%;
  }
  .more {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .article-body__grid {
      grid-template-columns: 1fr;
    }
    .article-lead {
      position: static;
    }
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 180px;
    }
    .more {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .lightbox {
      padding: 64px 12px;
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 16px;
    }
  }
</style>

<script>
  const gallery = document.querySelector('[data-gallery]');
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (gallery && box) {
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-open]')];
    const img = box.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = box.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let index = 0;
    const show = (i: number) => {
      index = (i + buttons.length) % buttons.length;
      const src = buttons[index].querySelector('img')!;
      img.src = src.currentSrc || src.src;
      img.alt = src.alt;
      caption.textContent = src.alt;
    };
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        show(i);
        box.showModal();
      }),
    );
    box.querySelector('[data-close]')?.addEventListener('click', () => box.close());
    box.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    box.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    box.addEventListener('click', (e) => e.target === box && box.close());
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  }
</script>
