---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PartnerMap from '../components/PartnerMap.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import Icon from '../components/Icon.astro';
import { countries } from '../data/partners';
import { getPartnersWithDcs, dcPath } from '../lib/data';
import { url, dcLabel } from '../lib/url';

const partners = await getPartnersWithDcs();
const beneficiaries = partners.filter((p) => p.role === 'beneficiary');
const associated = partners.filter((p) => p.role === 'associated');
---
<BaseLayout
  title="Consortium"
  description="ENGAGE beneficiaries and associated partners across Finland, Sweden, Germany and Austria, on an interactive map."
>
  <PageHero
    eyebrow={`${beneficiaries.length} beneficiaries · ${associated.length} associated partners · ${countries.length} countries`}
    title="Consortium"
    lead="Key European machine manufacturers and technology suppliers have joined forces with academic groups highly specialised in AI, robotics and mechanics. Explore who they are, where they are, and how the doctoral projects connect them."
  />
  <section class="section section--tight" style="padding-top:0">
    <div class="container">
      <PartnerMap />
    </div>
  </section>

  <section class="section section--elev">
    <div class="container">
      <div class="network">
        <div>
          <p class="eyebrow">The network</p>
          <h2 class="display h2">Sectors, suppliers and academics around 13 DCs</h2>
          <p class="lead">
            Machine manufacturers from construction and mining, forestry and agriculture, technology suppliers and academic groups each
            co-supervise doctoral projects — so every candidate works with both a university and a company.
          </p>
        </div>
        <img
          src={url('/images/brand/network-figure.webp')}
          width="1100"
          height="935"
          alt="The ENGAGE network: 13 doctoral candidates at the centre, surrounded by the construction and mining, forestry, agriculture and logistics sectors, the industrial suppliers and the academic partners"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="section-head">
        <div>
          <p class="eyebrow">Directory</p>
          <h2 class="display h2">Partners by country</h2>
        </div>
      </div>
      {
        countries.map((country) => {
          const list = partners.filter((p) => p.country === country);
          return (
            <section class="country" aria-labelledby={`c-${country}`}>
              <h3 class="country__name" id={`c-${country}`}>
                {country} <span>{list.length}</span>
              </h3>
              <ul class="directory">
                {list.map((p) => (
                  <li class="dir-card card" data-reveal>
                    <PartnerLogo partner={p} />
                    <div class="dir-card__body">
                      <p class="chips">
                        <span class:list={['chip', p.type === 'academic' ? 'chip--green' : 'chip--orange']}>
                          {p.type === 'academic' ? 'Academic' : 'Industry'}
                        </span>
                        <span class="chip">{p.role === 'beneficiary' ? 'Beneficiary' : 'Associated partner'}</span>
                        {p.coordinator && <span class="chip chip--green">Coordinator</span>}
                      </p>
                      <h4>{p.name}</h4>
                      <p class="muted dir-card__city">
                        <Icon name="pin" size={15} /> {p.city}
                      </p>
                      <p class="dir-card__about">{p.about}</p>
                      {(p.hosted.length > 0 || p.partnered.length > 0) && (
                        <p class="dir-card__dcs">
                          {[...p.hosted, ...p.partnered].map((dc) => (
                            <a href={url(dcPath(dc))} title={dc.data.shortTitle}>
                              {dcLabel(dc.data.number)}
                            </a>
                          ))}
                        </p>
                      )}
                      <a class="link-arrow" href={p.website} target="_blank" rel="noopener">
                        Website <Icon name="external" size={16} />
                      </a>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .network {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  .network img {
    width: 100%;
    height: auto;
  }
  @media (max-width: 900px) {
    .network {
      grid-template-columns: 1fr;
    }
  }
  .country + .country {
    margin-top: 48px;
  }
  .country__name {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.4rem;
    font-stretch: 116%;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
  }
  .country__name span {
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--accent);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .directory {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }
  .dir-card {
    display: flex;
    flex-direction: column;
    padding: 18px;
    gap: 16px;
  }
  .dir-card :global(.logo-plate) {
    height: 92px;
  }
  .dir-card :global(.logo-plate img) {
    max-height: 64px;
    max-width: 78%;
  }
  .dir-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .dir-card h4 {
    font-size: 1.15rem;
    margin: 4px 0 0;
  }
  .dir-card__city {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 0.88rem;
  }
  .dir-card__about {
    margin: 0;
    font-size: 0.93rem;
    color: var(--text-2);
  }
  .dir-card__dcs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 4px 0;
  }
  .dir-card__dcs a {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: 0.74rem;
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid rgb(247 168 35 / 0.45);
    color: var(--orange);
    text-decoration: none;
  }
  .dir-card__dcs a:hover {
    background: var(--orange);
    color: var(--ink);
  }
  .dir-card .link-arrow {
    margin-top: auto;
    padding-top: 6px;
    font-size: 0.9rem;
  }
</style>
