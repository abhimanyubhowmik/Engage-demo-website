---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DcCard from '../components/DcCard.astro';
import NewsCard from '../components/NewsCard.astro';
import PartnerMap from '../components/PartnerMap.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import { industries, industryOrder, themes, type ThemeId } from '../data/site';
import { getDcs, getNews, partners, dcPath } from '../lib/data';
import { url, dcLabel } from '../lib/url';

const dcs = await getDcs();
const news = (await getNews()).slice(0, 3);
const academic = partners.filter((p) => p.type === 'academic').length;
const companies = partners.filter((p) => p.type === 'industry').length;
const keywords = [...new Set(dcs.flatMap((d) => d.data.keywords))];
// one headline word per step; each industry keeps its background for all of its words
const heroWords = industryOrder.flatMap((id) => industries[id].words.map((word) => ({ word, industry: id })));
const themeOrder: ThemeId[] = ['perception', 'control', 'safety', 'simulation'];
---
<BaseLayout>
  <!-- HERO -->
  <section class="hero" data-hero>
    <div class="hero__media" aria-hidden="true">
      {
        industryOrder.map((id, i) => (
          <img
            class:list={['hero__slide', { 'is-active': i === 0 }]}
            data-slide={id}
            src={url(industries[id].image)}
            srcset={`${url(industries[id].imageSm)} 720w, ${url(industries[id].image)} 1080w`}
            sizes="(max-width: 700px) 100vw, 64vw"
            alt=""
            fetchpriority={i === 0 ? 'high' : 'low'}
            decoding="async"
          />
        ))
      }
    </div>
    <div class="hero__scan" aria-hidden="true"></div>
    <div class="container hero__content">
      <p class="eyebrow">Marie Skłodowska-Curie Doctoral Network · 2025–2029</p>
      <h1 class="display hero__title">
        <span class="sr-only">Intelligence for forestry, construction, mining, agriculture and logistics</span>
        <span aria-hidden="true">
          Intelligence<br />for
          <span class="hero__rotator" data-rotator>
            {heroWords.map((w, i) => <span class:list={{ 'is-active': i === 0 }} data-industry={w.industry}>{w.word}</span>)}
          </span>
        </span>
      </h1>
      <p class="lead hero__lead">
        Future engineers for safer, smarter and more sustainable mobile machines. ENGAGE trains {dcs.length} doctoral candidates in AI, robotics
        and mechanics — side by side with Europe’s leading machine manufacturers.
      </p>
      <div class="hero__actions">
        <a class="btn" href={url('/doctoral-candidates/')}>Meet the doctoral candidates <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href={url('/research/')}>Explore the research</a>
      </div>
      <div class="hero__tabs" role="group" aria-label="Show an industry">
        {
          industryOrder.map((id, i) => (
            <button type="button" class:list={['hero__tab', { 'is-active': i === 0 }]} data-tab={id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span>{industries[id].label}</span>
              <i aria-hidden="true" />
            </button>
          ))
        }
      </div>
    </div>
    <div class="hero__ticker" aria-hidden="true">
      <div class="hero__ticker-track">
        {
          [0, 1].map(() => (
            <div class="hero__ticker-group">
              {keywords.map((k) => (
                <>
                  <span>{k}</span>
                  <i />
                </>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats" aria-label="ENGAGE in numbers">
    <div class="container stats__grid">
      <div class="stat" data-reveal><strong data-count={dcs.length}>{dcs.length}</strong><span>Doctoral candidates</span></div>
      <div class="stat" data-reveal style="--reveal-delay:80ms"><strong data-count={academic}>{academic}</strong><span>Academic groups</span></div>
      <div class="stat" data-reveal style="--reveal-delay:160ms"><strong data-count={companies}>{companies}</strong><span>Industry partners</span></div>
      <div class="stat" data-reveal style="--reveal-delay:240ms"><strong data-count="4">4</strong><span>Countries</span></div>
      <div class="stat" data-reveal style="--reveal-delay:320ms"><strong data-count="48">48</strong><span>Months of research</span></div>
    </div>
  </section>

  <!-- MISSION -->
  <section class="section mission">
    <div class="container mission__grid">
      <div data-reveal>
        <p class="eyebrow">Why ENGAGE</p>
        <h2 class="display h2">The machines behind our economy are getting a brain.</h2>
      </div>
      <div class="mission__text" data-reveal style="--reveal-delay:120ms">
        <p class="lead">
          Mobile working machines are everywhere in construction, mining, forestry, agriculture and logistics — and vital to a sustainable,
          productive society.
        </p>
        <p>
          Ambitious goals for sustainability, productivity and safety, coupled with a shortage of skilled people, have brought Europe’s
          mobile-machine ecosystem together in this network of Industrial Doctorates. Each doctoral candidate is supervised jointly by a university
          and a company, and spends time in both.
        </p>
        <a class="link-arrow" href={url('/research/')}>Our research objectives <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section--tight industries" aria-labelledby="industries-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Where our machines work</p>
          <h2 class="display h2" id="industries-title">One network, four industries</h2>
        </div>
        <a class="link-arrow" href={url('/doctoral-candidates/')}>All projects <Icon name="arrow-right" /></a>
      </div>
      <div class="industries__grid">
        {
          industryOrder.map((id, i) => {
            const ind = industries[id];
            const count = dcs.filter((d) => d.data.industries.includes(id)).length;
            return (
              <a class="industry" href={url(`/doctoral-candidates/?industry=${id}`)} data-reveal style={`--reveal-delay:${i * 70}ms`}>
                <img src={url(ind.imageSm)} alt="" loading="lazy" decoding="async" />
                <span class="industry__body">
                  <span class="industry__count">{count} {count === 1 ? 'project' : 'projects'}</span>
                  <span class="industry__title">{ind.label}</span>
                  <span class="industry__blurb">{ind.blurb}</span>
                </span>
                <span class="industry__arrow">
                  <Icon name="arrow-up-right" size={22} />
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- RESEARCH THEMES -->
  <section class="section section--paper themes" aria-labelledby="themes-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Research objectives</p>
          <h2 class="display h2" id="themes-title">Four objectives, one goal</h2>
          <p class="lead">
            New methods, processes and algorithms — using robotisation and AI — with proof-of-concept on representative cases, to make mobile
            working machine industries more sustainable, productive and safe.
          </p>
        </div>
        <a class="btn btn--ghost" href={url('/research/')}>Read the objectives</a>
      </div>
      <div class="themes__grid">
        {
          themeOrder.map((id, i) => {
            const t = themes[id];
            const list = dcs.filter((d) => d.data.theme === id);
            return (
              <article class="theme" data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <div class="theme__media">
                  <img src={url(t.image.replace('.webp', '-sm.webp'))} alt="" loading="lazy" decoding="async" />
                  <span class="theme__num">0{t.objective}</span>
                </div>
                <div class="theme__body">
                  <h3>{t.label}</h3>
                  <p>{t.blurb}</p>
                  <p class="theme__dcs">
                    {list.map((dc) => (
                      <a href={url(dcPath(dc))} title={dc.data.shortTitle}>
                        {dcLabel(dc.data.number)}
                      </a>
                    ))}
                  </p>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- DC CAROUSEL -->
  <section class="section people" aria-labelledby="people-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The people</p>
          <h2 class="display h2" id="people-title">Meet our doctoral candidates</h2>
          <p class="lead">Thirteen doctoral projects — each co-supervised by a university and an industrial partner.</p>
        </div>
        <div class="carousel-nav">
          <button type="button" class="carousel-btn" data-carousel-prev aria-label="Previous"><Icon name="arrow-left" /></button>
          <button type="button" class="carousel-btn" data-carousel-next aria-label="Next"><Icon name="arrow-right" /></button>
        </div>
      </div>
    </div>
    <div class="carousel" data-carousel>
      <ul class="carousel__track" data-carousel-track>
        {
          dcs.map((dc) => (
            <li>
              <DcCard dc={dc} compact />
            </li>
          ))
        }
      </ul>
    </div>
    <div class="container people__cta">
      <a class="btn" href={url('/doctoral-candidates/')}>See all doctoral candidates <Icon name="arrow-right" /></a>
      <a class="btn btn--ghost" href={url('/supervisors/')}>Meet the supervisors</a>
    </div>
  </section>

  <!-- MAP -->
  <section class="section section--elev map-teaser" aria-labelledby="map-title">
    <div class="container map-teaser__grid">
      <div data-reveal>
        <p class="eyebrow">Consortium</p>
        <h2 class="display h2" id="map-title">Across Europe’s machine heartland</h2>
        <p class="lead">
          Universities, research institutes, machine manufacturers and technology suppliers in Finland, Sweden, Germany and Austria — linked by
          the doctoral projects they share.
        </p>
        <div class="map-teaser__counts">
          <div><strong>{partners.filter((p) => p.role === 'beneficiary').length}</strong><span>Beneficiaries</span></div>
          <div><strong>{partners.filter((p) => p.role === 'associated').length}</strong><span>Associated partners</span></div>
          <div><strong>{new Set(partners.map((p) => p.city)).size}</strong><span>Cities</span></div>
        </div>
        <a class="btn" href={url('/consortium/')}>Explore the map <Icon name="arrow-right" /></a>
      </div>
      <div data-reveal style="--reveal-delay:120ms">
        <PartnerMap compact />
      </div>
    </div>
  </section>

  <!-- NEWS -->
  <section class="section" aria-labelledby="news-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">News & events</p>
          <h2 class="display h2" id="news-title">Latest from the network</h2>
        </div>
        <a class="link-arrow" href={url('/news/')}>All news <Icon name="arrow-right" /></a>
      </div>
      <div class="news-grid">
        {
          news.map((post, i) => (
            <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <NewsCard post={post} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PARTNER LOGOS -->
  <section class="section section--tight logos" aria-labelledby="logos-title">
    <div class="container">
      <p class="eyebrow" id="logos-title">Our partners</p>
      <ul class="logos__grid">
        {
          partners.map((p) => (
            <li>
              <a href={p.website} target="_blank" rel="noopener" title={p.name}>
                <PartnerLogo partner={p} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <img class="cta__bg" src={url('/images/photos/forest-ground.webp')} alt="" loading="lazy" />
    <div class="container cta__inner">
      <h2 class="display h2">Building the next generation of mobile working machines?</h2>
      <p class="lead">Talk to us about collaboration, training events or the research behind ENGAGE.</p>
      <div class="hero__actions">
        <a class="btn" href={url('/contact/')}>Get in touch <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href={url('/news/')}>News & events</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* hero */
  .hero {
    position: relative;
    min-height: max(640px, 100svh);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    overflow: hidden;
  }
  /* portrait industry images sit on the right and fade into the page background on the left */
  .hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 64%;
    z-index: -3;
    mask-image: linear-gradient(90deg, transparent 0%, #000 30%);
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 62%;
    opacity: 0;
    transform: scale(1.07);
    transition:
      opacity 1.4s var(--ease),
      transform 7s ease-out;
  }
  .hero__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgb(var(--deep-rgb) / 0.92) 0%, rgb(var(--deep-rgb) / 0.6) 40%, rgb(var(--deep-rgb) / 0) 72%),
      linear-gradient(180deg, rgb(var(--deep-rgb) / 0.55) 0%, transparent 25%, transparent 60%, var(--bg) 100%);
  }
  .hero__scan {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgb(var(--accent-rgb) / 0.09) 48%, rgb(var(--accent-rgb) / 0.22) 50%, transparent 52%);
    background-size: 100% 240%;
    mix-blend-mode: screen;
    animation: hero-scan 7s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes hero-scan {
    from {
      background-position: 0 120%;
    }
    to {
      background-position: 0 -120%;
    }
  }
  .hero__content {
    padding-top: calc(var(--header-h) + 60px);
    padding-bottom: 56px;
  }
  .hero__title {
    font-size: clamp(2.1rem, 7.2vw, 6.4rem);
    margin-bottom: 28px;
  }
  .hero__rotator {
    display: grid;
    color: var(--orange);
  }
  .hero__rotator span {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.35em);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
    white-space: nowrap;
  }
  .hero__rotator span.is-active {
    opacity: 1;
    transform: none;
  }
  .hero__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
  }
  .hero__tab {
    position: relative;
    overflow: hidden;
    padding: 9px 16px 11px;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 0.16);
    background: rgb(var(--deep-rgb) / 0.55);
    backdrop-filter: blur(6px);
    color: var(--text-2);
    font-family: var(--font-display);
    font-stretch: 108%;
    font-weight: 650;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color 0.3s,
      border-color 0.3s;
  }
  .hero__tab:hover {
    color: var(--text);
  }
  .hero__tab.is-active {
    color: var(--text);
    border-color: rgb(var(--accent-rgb) / 0.6);
  }
  .hero__tab i {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__tab.is-active i {
    transform: scaleX(1);
  }
  .hero.is-playing .hero__tab.is-active i {
    animation: hero-progress var(--dur, 5s) linear both;
  }
  @keyframes hero-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .hero__lead {
    color: var(--text);
    opacity: 0.92;
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hero__ticker {
    position: relative;
    border-block: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(10 12 40 / 0.72);
    backdrop-filter: blur(8px);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .hero__ticker-track {
    display: flex;
    width: max-content;
    animation: ticker 70s linear infinite;
  }
  .hero__ticker-group {
    display: flex;
    align-items: center;
    gap: 22px;
    padding: 16px 11px;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero__ticker-group span:nth-of-type(3n + 1) {
    color: var(--accent);
  }
  .hero__ticker-group span:nth-of-type(3n + 2) {
    color: var(--text);
  }
  .hero__ticker-group span:nth-of-type(3n) {
    color: var(--orange);
  }
  .hero__ticker-group i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.5);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* stats */
  .stats {
    border-bottom: 1px solid var(--line);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .stat {
    padding: 34px 12px;
    text-align: center;
    border-left: 1px solid var(--line);
  }
  .stat:first-child {
    border-left: 0;
  }
  .stat strong {
    display: block;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 850;
    font-size: clamp(2.4rem, 4.6vw, 3.8rem);
    line-height: 1;
    color: var(--text);
  }
  .stat:nth-child(odd) strong {
    color: var(--accent);
  }
  .stat span {
    display: block;
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* mission */
  .mission__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .mission__text p:not(.lead) {
    color: var(--text-2);
  }

  /* industries */
  .industries__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .industry {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 3 / 4.3;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    isolation: isolate;
    border: 1px solid var(--line);
  }
  .industry img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 1s var(--ease);
  }
  .industry::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(var(--deep-rgb) / 0) 25%, rgb(var(--deep-rgb) / 0.45) 55%, rgb(var(--deep-rgb) / 0.95) 100%);
  }
  .industry:hover img {
    transform: scale(1.06);
  }
  .industry__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
  }
  .industry__count {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
  }
  .industry__title {
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 820;
    text-transform: uppercase;
    font-size: clamp(1.35rem, 1.9vw, 1.75rem);
    line-height: 1.02;
  }
  .industry__blurb {
    color: var(--text-2);
    font-size: 0.93rem;
    max-width: 40ch;
  }
  .industry__arrow {
    position: absolute;
    top: 18px;
    right: 18px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(var(--deep-rgb) / 0.6);
    border: 1px solid rgb(255 255 255 / 0.2);
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.3s var(--ease);
  }
  .industry:hover .industry__arrow {
    background: var(--orange);
    color: var(--ink);
    transform: rotate(45deg);
  }

  /* themes */
  .themes__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .theme {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--paper-2);
    overflow: hidden;
    box-shadow: 0 18px 40px -30px rgb(var(--ink-rgb) / 0.5);
  }
  .theme__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--ink);
  }
  .theme__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .theme__num {
    position: absolute;
    left: 16px;
    bottom: 10px;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 850;
    font-size: 2.6rem;
    line-height: 1;
    color: #fff;
  }
  .theme__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 20px 22px;
  }
  .theme__body h3 {
    font-size: 1.2rem;
  }
  .theme__body p {
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .theme__dcs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: auto 0 0 !important;
  }
  .theme__dcs a {
    font-family: var(--font-display);
    font-stretch: 115%;
    font-weight: 800;
    font-size: 0.75rem;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--paper);
    border: 1px solid var(--paper-2);
    color: var(--ink);
    text-decoration: none;
  }
  .theme__dcs a:hover {
    background: var(--orange);
    border-color: var(--orange);
  }

  /* carousel */
  .carousel-nav {
    display: flex;
    gap: 10px;
  }
  .carousel-btn {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }
  .carousel-btn:hover {
    background: var(--accent);
    color: var(--ink);
    border-color: var(--accent);
  }
  .carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(240px, 23vw, 300px);
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 4px max(var(--gutter), calc((100vw - var(--container)) / 2)) 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2));
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__track li {
    scroll-snap-align: start;
  }
  .people__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  /* map teaser */
  .map-teaser__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .map-teaser__counts {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin: 28px 0 32px;
  }
  .map-teaser__counts strong {
    display: block;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 850;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--orange);
  }
  .map-teaser__counts span {
    color: var(--muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* news */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* logos */
  .logos__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .logos__grid a {
    display: block;
    transition: transform 0.25s var(--ease);
  }
  .logos__grid a:hover {
    transform: translateY(-3px);
  }
  .logos__grid :global(.logo-plate) {
    height: 80px;
  }
  .logos__grid :global(.logo-plate img) {
    max-height: 50px;
    max-width: 88%;
  }
  .logos__grid :global(.logo-plate img[src$='tuv-sud.png']) {
    max-height: 62px;
  }
  .logos__grid :global(.logo-plate--text) {
    font-size: 0.85rem;
  }

  /* cta */
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(80px, 11vw, 160px);
    text-align: center;
  }
  .cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--bg) 0%, rgb(var(--bg-rgb) / 0.7) 35%, rgb(var(--bg-rgb) / 0.75) 65%, var(--bg-deep) 100%);
  }
  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cta__inner h2 {
    max-width: 18ch;
  }
  .cta__inner .lead {
    margin-inline: auto;
  }

  @media (max-width: 1080px) {
    .themes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .industries__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 900px) {
    .mission__grid,
    .map-teaser__grid {
      grid-template-columns: 1fr;
    }
    .news-grid {
      grid-template-columns: 1fr;
    }
    .stats__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .stat:nth-child(4) {
      border-left: 0;
    }
    .stat:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 600px) {
    .themes__grid {
      grid-template-columns: 1fr;
    }
    .industries__grid {
      grid-template-columns: 1fr;
    }
    .industry {
      aspect-ratio: 4 / 3.4;
    }
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat {
      padding: 24px 8px;
    }
    .stat:nth-child(odd) {
      border-left: 0;
    }
    .stat:nth-child(4) {
      border-left: 1px solid var(--line);
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .stat:last-child {
      grid-column: span 2;
    }
    .carousel__track {
      grid-auto-columns: 78vw;
    }
    .hero__media {
      width: 100%;
      mask-image: none;
    }
    .hero::before {
      background: linear-gradient(180deg, rgb(var(--deep-rgb) / 0.72) 0%, rgb(var(--deep-rgb) / 0.62) 35%, rgb(var(--deep-rgb) / 0.9) 68%, var(--bg) 100%);
    }
    .hero__tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .hero__tabs::-webkit-scrollbar {
      display: none;
    }
    .hero__tab {
      flex-shrink: 0;
    }
  }
</style>

<script>
  // hero: the headline word, the background image and the industry tab move together
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const words = [...hero.querySelectorAll<HTMLElement>('[data-rotator] > span')];
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const tabs = [...hero.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const STEP = 2800;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = 0;
    const show = (i: number, restart = false) => {
      index = (i + words.length) % words.length;
      const industry = words[index].dataset.industry;
      words.forEach((w, k) => w.classList.toggle('is-active', k === index));
      slides.forEach((sl) => sl.classList.toggle('is-active', sl.dataset.slide === industry));
      for (const t of tabs) {
        const on = t.dataset.tab === industry;
        t.setAttribute('aria-pressed', String(on));
        if (!on) {
          t.classList.remove('is-active');
        } else if (restart || !t.classList.contains('is-active')) {
          // the progress bar runs for as long as this industry stays on screen
          const remaining = words.slice(index).filter((w) => w.dataset.industry === industry).length;
          t.style.setProperty('--dur', `${remaining * STEP}ms`);
          t.classList.remove('is-active');
          void t.offsetWidth;
          t.classList.add('is-active');
        }
      }
    };
    const schedule = () => {
      clearTimeout(timer);
      if (reduce || document.hidden) return;
      timer = window.setTimeout(() => {
        show(index + 1);
        schedule();
      }, STEP);
    };
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        show(
          words.findIndex((w) => w.dataset.industry === t.dataset.tab),
          true,
        );
        schedule();
      }),
    );
    if (!reduce) {
      hero.classList.add('is-playing');
      show(0, true);
      document.addEventListener('visibilitychange', schedule);
      schedule();
    }
  }
  // carousel buttons
  const track = document.querySelector<HTMLElement>('[data-carousel-track]');
  const by = () => (track?.querySelector('li')?.getBoundingClientRect().width ?? 300) + 20;
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => track?.scrollBy({ left: -by(), behavior: 'smooth' }));
  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => track?.scrollBy({ left: by(), behavior: 'smooth' }));
</script>
