<script>
  // rotating headline word
  const rot = document.querySelector<HTMLElement>('[data-rotator]');
  if (rot && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = [...rot.children] as HTMLElement[];
    let i = words.length - 1;
    const step = () => {
      words[i].classList.remove('is-active');
      i = (i + 1) % words.length;
      words[i].classList.add('is-active');
      setTimeout(step, i === words.length - 1 ? 4200 : 1900);
    };
    setTimeout(step, 3200);
  }
  // carousel buttons
  const track = document.querySelector<HTMLElement>('[data-carousel-track]');
  const by = () => (track?.querySelector('li')?.getBoundingClientRect().width ?? 300) + 20;
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => track?.scrollBy({ left: -by(), behavior: 'smooth' }));
  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => track?.scrollBy({ left: by(), behavior: 'smooth' }));
</script>
